{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "sveltekit",
	"installCommand": "cd ../.. && npm ci",
	"buildCommand": "cd ../.. && npx turbo run build --filter=@trailblazers/web",
	"headers": [
		{
			"source": "/images/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		}
	]
}
