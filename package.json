{
	"name": "trailblazers-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "npm@10.8.2",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:web": "npm run dev -w @trailblazers/web",
		"dev:admin": "npm run dev -w @trailblazers/admin",
		"build": "turbo build",
		"build:web": "npm run build -w @trailblazers/web",
		"build:admin": "npm run build -w @trailblazers/admin",
		"preview": "npm run preview -w @trailblazers/web",
		"check": "turbo check",
		"check:web": "npm run check -w @trailblazers/web",
		"check:admin": "npm run check -w @trailblazers/admin",
		"test": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs --test \"packages/*/src/**/*.test.ts\"",
		"test:watch": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs --test --watch \"packages/*/src/**/*.test.ts\"",
		"test:e2e": "playwright test",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"prepare": "npm run prepare -w @trailblazers/web",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
		"db:push": "drizzle-kit push --config drizzle.config.ts",
		"db:health": "node scripts/db-health-check.js",
		"seed": "npm run seed -w @trailblazers/web"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.62.1",
		"drizzle-kit": "^0.31.8",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"turbo": "2.10.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.20.0"
	},
	"engines": {
		"node": ">=22"
	}
}
