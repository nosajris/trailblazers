# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trailblazers?sslmode=disable"
DB_USER="postgres"
DB_PASSWORD="postgres_password"
DB_NAME="trailblazers"

# Session & Security
#
# SECRET_KEY keys the HMAC that protects session and password tokens at rest:
# the database stores only hashes, so a leaked backup cannot be replayed. It is
# required in production and the server refuses to start without a real one —
# at least 32 characters, and not this placeholder.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it invalidates every active session and every outstanding invite or
# password-reset link, which is the intended behaviour after a leak.
SECRET_KEY="super_secret_production_key_change_me"
NODE_ENV="production"

# Application Ports
WEB_PORT=5173
ADMIN_PORT=5174

# Transactional email (Resend)
#
# All three are optional. Without RESEND_API_KEY the email service logs each
# message instead of sending it, which is what local development and CI want —
# nothing breaks, and no mail is delivered to real people from a dev machine.
#
# EMAIL_FROM must be an address on a domain verified in Resend.
# OFFICE_EMAIL is where staff notifications (contact forms, group interest,
# volunteer applications) are delivered.
RESEND_API_KEY=""
EMAIL_FROM="Trailblazers <hello@example.org>"
OFFICE_EMAIL="office@example.org"

# Uploaded images (Vercel Blob)
#
# Staff-uploaded photos (page sections, and future upload points) are
# resized, converted to webp and stored here — see
# packages/core/src/modules/media/service.ts. Create a Blob store under the
# Vercel project (Storage tab) and copy its read-write token; `vercel env
# pull` also fetches it automatically once the store is attached. Without it,
# the upload action fails with a clear error rather than writing to disk,
# which would not survive a serverless deploy.
BLOB_READ_WRITE_TOKEN=""

# Daily cron job (event reminders + weekly analytics digest)
#
# apps/web/src/routes/api/cron/daily/+server.ts, scheduled by the `crons`
# entry in apps/web/vercel.json. CRON_SECRET is optional locally (the
# endpoint logs a warning and runs unauthenticated) but should be set in
# production — Vercel sends it back as `Authorization: Bearer <value>` on
# every cron invocation automatically once this variable exists, so no code
# change is needed beyond setting it.
#
# ADMIN_URL is the staff portal's deployed URL, used only to link to the
# analytics page from the weekly digest email. Without it, the email says
# "the staff analytics page" instead of a clickable link.
CRON_SECRET=""
ADMIN_URL="https://admin.example.org"
